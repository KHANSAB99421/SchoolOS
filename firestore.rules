rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Check if user is registered staff of this school
    function isSchoolStaff(schoolId) {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId)
      );
    }

    function isSchoolAdmin(schoolId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/schools/$(schoolId)/users/$(request.auth.uid)).data.role == 'admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolId == schoolId &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Global user profile lookup
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // School Organization Root
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSchoolAdmin(schoolId);
      allow delete: if isSchoolAdmin(schoolId);

      // School Users
      match /users/{userId} {
        allow read: if isSchoolStaff(schoolId) || isOwner(userId);
        allow create, update: if isSchoolAdmin(schoolId) || isOwner(userId);
        allow delete: if isSchoolAdmin(schoolId);
      }

      // Students
      match /students/{studentId} {
        allow read: if isSchoolStaff(schoolId);
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      // Fee Structures
      match /feeStructures/{structureId} {
        allow read: if isSchoolStaff(schoolId);
        allow create, update, delete: if isSchoolAdmin(schoolId);
      }

      // Payments
      match /payments/{paymentId} {
        allow read: if isSchoolStaff(schoolId);
        allow create: if isSchoolStaff(schoolId);
        allow update, delete: if isSchoolAdmin(schoolId);
      }

      // Metadata / Sequences
      match /meta/{docId} {
        allow read, write: if isSchoolStaff(schoolId);
      }
    }
  }
}
